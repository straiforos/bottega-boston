{
  "name": "custom_design_system_tanstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "infra:init": "tofu -chdir=infra/cloudflare init",
    "infra:plan": "tofu -chdir=infra/cloudflare plan -var-file=terraform.tfvars",
    "infra:apply": "tofu -chdir=infra/cloudflare apply -var-file=terraform.tfvars",
    "db:migrate:local": "wrangler d1 migrations apply bottega --local",
    "db:migrate:remote": "wrangler d1 migrations apply bottega --remote",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.25.5",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "@usewaypoint/email-builder": "^0.0.9",
    "aws4fetch": "^1.0.20",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.15.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "supabase": "^2.122.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.154.0"
  }
}
