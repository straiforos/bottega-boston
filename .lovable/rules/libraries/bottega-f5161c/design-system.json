        },
        {
          "label": "External directions link",
          "code": "\u003cLinkAction href=\"https://maps.google.com/?q=41.8986,12.4769\" target=\"_blank\" aria-label=\"Get directions (opens in a new tab)\"\u003eGet directions\u003c/LinkAction\u003e"
        }
      ],
      "antipatterns": [
        "Do not use LinkAction as the main CTA; the primary action is Button.",
        "Do not pass rel by hand or build a raw \u003ca target=\"_blank\"\u003e; LinkAction adds rel=\"noopener noreferrer\" automatically."
