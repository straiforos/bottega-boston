        {
          "label": "Location with card",
          "code": "\u003cBottegaMap label=\"Map showing Bottega\" center={{ lat: 41.8986, lng: 12.4769 }} markers={[{ lat: 41.8986, lng: 12.4769, title: \"Bottega\" }]} /\u003e"
