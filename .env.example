# Vite (client). Deploy injects the Maps key from GOOGLE_MAPS_BROWSER_KEY.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Worker secrets for local Miniflare / Wrangler.
# Copy this block into .dev.vars (gitignored). Server code reads env from
# cloudflare:workers, which Wrangler fills from .dev.vars — not from .env.
# Production uses GitHub Actions → wrangler secret bulk.
#
# Local OAuth / email absolutizing: override the wrangler.jsonc default.
SITE_ORIGIN=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Clover Hosted Checkout (sandbox first).
# CLOVER_API_BASE=https://apisandbox.dev.clover.com
CLOVER_API_BASE=
CLOVER_MERCHANT_ID=
CLOVER_ECOMMERCE_PRIVATE_TOKEN=
CLOVER_WEBHOOK_SECRET=

# Local-only: scripts/import-chownow-photos.ts (not a Worker secret).
GEMINI_API_KEY=
